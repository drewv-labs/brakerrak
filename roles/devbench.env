# ==============================================================================
# DREW-V Labs // BrakerRak Role Persona: devbench
# Hybrid GPU/NPU + Data Dev Bench (DevBench | DevBnch | tag: dev)
# Hot-Swappable Role Configs & Tunes: PG18 (io_uring) + Pigeoneer (+ Optional Supplemental MQTT)
# Note: Mosquitto MQTT is an optional supplemental telemetry transport; set
#       REQUIRE_MQTT_BROKER=true only if inactive MQTT should fail Day-1 ORT.
# ==============================================================================
NODE_ROLE="devbench"
TARGET_HOSTNAME="${TARGET_HOSTNAME:-devbench-${TARGET_TAG:-node}}"
RVDK_TUNE_PROFILE="${RVDK_TUNE_PROFILE:-ai}"
WITH_RAID="${WITH_RAID:-false}"
ENABLE_POSTGRES="${ENABLE_POSTGRES:-true}"
ENABLE_MQTT_BROKER="${ENABLE_MQTT_BROKER:-true}"
MQTT_PORT="${MQTT_PORT:-1883}"
ENABLE_NFS_SERVER="${ENABLE_NFS_SERVER:-false}"
PIGEON_ROLE="${PIGEON_ROLE:-pigeoneer}"
