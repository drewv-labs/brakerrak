# ==============================================================================
# DREW-V Labs // BrakerRak Role Persona: databroker
# Production Data Broker (BrakerBox | BrakBox | tag: brx)
# PostgreSQL 18 (io_uring) + NFSv4 + PigeonCoop (+ Optional Supplemental Mosquitto MQTT)
# Note: Mosquitto MQTT is an optional supplemental telemetry transport; set
#       REQUIRE_MQTT_BROKER=true only if inactive MQTT should fail Day-1 ORT.
# ==============================================================================
NODE_ROLE="databroker"
TARGET_HOSTNAME="${TARGET_HOSTNAME:-brakerbox-${TARGET_TAG:-node}}"
RVDK_TUNE_PROFILE="${RVDK_TUNE_PROFILE:-data}"
ENABLE_POSTGRES="${ENABLE_POSTGRES:-true}"
ENABLE_MQTT_BROKER="${ENABLE_MQTT_BROKER:-true}"
MQTT_PORT="${MQTT_PORT:-1883}"
ENABLE_NFS_SERVER="${ENABLE_NFS_SERVER:-true}"
PIGEON_ROLE="${PIGEON_ROLE:-pigeoncoop+pigeoneer}"
