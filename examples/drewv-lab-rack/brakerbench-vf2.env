# ==============================================================================
# DREW-V Labs // Reference Config: BrakerBench-VF2 (15U Rack U02 DataBench)
# Copy to ~/.brakerrak/node.env on BrakerBench-VF2
# ==============================================================================
NODE_ROLE="databench"
TARGET_HOSTNAME="brakerbench-vf2"
ADMIN_USER="drew"
LAB_SUBNET="10.0.10.0/24"

# Hot NVMe Storage (WD_BLACK SN750 2TB on PCIe Gen2 x1)
NVME_DEV="/dev/nvme0n1"
MOUNT_POINT="/mnt/nvme_pgdata"

# Isolated Benchmark Node (Zero RAID/MQTT/NFS Daemons)
WITH_RAID="false"
RAID_ARRAYS_JSON='[]'
ENABLE_MQTT_BROKER="false"
MQTT_PORT="1883"
ENABLE_NFS_SERVER="false"
SHARE_ORT_SNAPSHOT="false"
